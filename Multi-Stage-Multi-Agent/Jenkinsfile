pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Start Database') {

            agent any

            steps {
                checkout scm

                sh '''
                    echo "=========================================="
                    echo "Starting PostgreSQL"
                    echo "=========================================="

                    docker network inspect app-network >/dev/null 2>&1 || \
                    docker network create app-network

                    echo "Removing old PostgreSQL container..."

                    docker rm -f postgres >/dev/null 2>&1 || true

                    echo "Starting PostgreSQL..."

                    docker run -d \
                        --name postgres \
                        --network app-network \
                        -e POSTGRES_DB=appdb \
                        -e POSTGRES_USER=appuser \
                        -e POSTGRES_PASSWORD=apppassword \
                        postgres:16-alpine

                    echo "Waiting for PostgreSQL..."

                    until docker exec postgres \
                        pg_isready \
                        -U appuser \
                        -d appdb >/dev/null 2>&1
                    do
                        echo "PostgreSQL is not ready..."
                        sleep 2
                    done

                    echo "PostgreSQL is ready!"
                '''
            }
        }


        stage('Back-end') {
    agent {
        docker {
            image 'maven:3.8.8-eclipse-temurin-11'
            args '--network app-network'
        }
    }

    steps {
        checkout scm

        sh '''
            echo "===== GIT CHECK ====="
            echo "Commit:"
            git rev-parse HEAD

            echo "===== FILES IN GIT ====="
            git ls-tree -r --name-only HEAD

            echo "===== WORKSPACE FILES ====="
            find . -maxdepth 3 -type f | sort
        '''

        dir('backend') {
            sh '''
                echo "===== BACKEND ====="
                pwd
                ls -la

                echo "Checking pom.xml..."
                ls -l pom.xml

                mvn --version

                mvn clean test \
                  -Dspring.datasource.url=jdbc:postgresql://postgres:5432/appdb \
                  -Dspring.datasource.username=appuser \
                  -Dspring.datasource.password=apppassword
            '''
        }
    }
}

        stage('Front-end') {

            agent {
                docker {
                    image 'node:20-alpine'
                }
            }

            steps {

                checkout scm

                dir('frontend') {

                    sh '''
                        echo "=========================================="
                        echo "FRONTEND BUILD"
                        echo "=========================================="

                        echo "Current directory:"
                        pwd

                        echo "Frontend files:"
                        ls -la

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."

                        npm install

                        echo "Running frontend tests..."

                        npm test

                        echo "Frontend tests completed successfully!"
                    '''
                }
            }
        }
    }


    post {

        success {
            echo "=========================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "=========================================="
        }
    }
}
