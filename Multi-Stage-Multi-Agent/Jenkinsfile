pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
    }

    stages {

        /*
         * ---------------------------------------------------------
         * STAGE 1: START DATABASE
         * ---------------------------------------------------------
         */
        stage('Start Database') {
            agent any

            steps {
                checkout scm

                sh '''
                    echo "Creating Docker network..."

                    docker network inspect app-network >/dev/null 2>&1 || \
                    docker network create app-network

                    echo "Removing old PostgreSQL container if present..."

                    docker rm -f postgres >/dev/null 2>&1 || true

                    echo "Starting PostgreSQL..."

                    docker run -d \
                        --name postgres \
                        --network app-network \
                        -e POSTGRES_DB=appdb \
                        -e POSTGRES_USER=appuser \
                        -e POSTGRES_PASSWORD=apppassword \
                        postgres:16-alpine

                    echo "Waiting for PostgreSQL..."

                    until docker exec postgres \
                        pg_isready \
                        -U appuser \
                        -d appdb >/dev/null 2>&1
                    do
                        echo "PostgreSQL is not ready yet..."
                        sleep 2
                    done

                    echo "PostgreSQL is ready!"
                '''
            }
        }


        /*
         * ---------------------------------------------------------
         * STAGE 2: BACK-END
         * ---------------------------------------------------------
         */
        stage('Back-end') {

            agent {
                docker {
                    image 'maven:3.8.8-eclipse-temurin-11'
                    args '--network app-network'
                }
            }

            steps {

                checkout scm

                /*
                 * IMPORTANT:
                 * pom.xml is inside backend/
                 */
                dir('backend') {

                    sh '''
                        echo "======================================"
                        echo "Backend Build"
                        echo "======================================"

                        echo "Current directory:"
                        pwd

                        echo "Backend files:"
                        ls -la

                        echo "Checking pom.xml:"
                        ls -l pom.xml

                        echo "Maven version:"
                        mvn --version

                        echo "Running Maven tests..."

                        mvn clean test \
                          -Dspring.datasource.url=jdbc:postgresql://postgres:5432/appdb \
                          -Dspring.datasource.username=appuser \
                          -Dspring.datasource.password=apppassword
                    '''
                }
            }
        }


        /*
         * ---------------------------------------------------------
         * STAGE 3: FRONT-END
         * ---------------------------------------------------------
         */
        stage('Front-end') {

            agent {
                docker {
                    image 'node:20-alpine'
                }
            }

            steps {

                checkout scm

                dir('frontend') {

                    sh '''
                        echo "======================================"
                        echo "Frontend Build"
                        echo "======================================"

                        echo "Current directory:"
                        pwd

                        echo "Frontend files:"
                        ls -la

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."

                        npm install

                        echo "Running frontend tests..."

                        npm test
                    '''
                }
            }
        }
    }


    /*
     * ---------------------------------------------------------
     * POST ACTIONS
     * ---------------------------------------------------------
     */
    post {

        always {

            node {

                sh '''
                    echo "======================================"
                    echo "Cleaning up Docker resources"
                    echo "======================================"

                    docker rm -f postgres >/dev/null 2>&1 || true

                    docker network rm app-network >/dev/null 2>&1 || true

                    echo "Cleanup completed."
                '''
            }
        }

        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Please check the stage logs.'
        }
    }
}
